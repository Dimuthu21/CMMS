@model CMMS_DAL.Modules.Core.Models.IssueMethodViewModel

@{
    ViewBag.Title = "Issue Method";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    @* keep your global css in layout, only add if needed *@
}



<div class="content__boxed">
    <div class="content__wrap">

        <!-- =========================
         TOP CARD (FORM)
    ========================== -->
        <div class="card mb-3">
            <div class="card-body">

                @Html.HiddenFor(m => m.Id, new { id = "IssueMethodId" })

                <div class="row g-3">

                    <!-- Code -->
                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Code <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Code, new { @class = "form-control", id = "IssueMethodCode", @readonly = "readonly" })
                        <span class="text-danger" id="valIssueMethodCode"></span>
                    </div>

                    <!-- User Preferred -->
                    <div class="col-lg-3 col-md-6 col-sm-12 d-flex align-items-center">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="IssueMethodIsUserPreferred">
                            <label class="form-check-label" for="IssueMethodIsUserPreferred">User Preferred</label>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12 col-sm-12"></div>

                    <!-- Issue Type Name -->
                    <div class="col-lg-6 col-md-12 col-sm-12">
                        <label class="form-label">Issue Type Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.IssueTypeName, new { @class = "form-control trim-start", id = "IssueMethodName", placeholder = "Issue Type" })
                        <span class="text-danger" id="valIssueMethodName"></span>
                    </div>

                    <!-- Status -->
                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Status <span class="text-danger">*</span></label>
                        <div class="position-relative">
                            @Html.DropDownListFor(m => m.Status,
                                new SelectList(new[] { new { Value = "", Text = "Select" } }, "Value", "Text"),
                                new { @class = "form-control", id = "IssueMethodStatus" })
                            <i class="fa fa-caret-down position-absolute"
                               style="right:12px; top:50%; transform:translateY(-50%); pointer-events:none;"></i>
                        </div>
                        <span class="text-danger" id="valIssueMethodStatus"></span>
                    </div>

                    <div class="col-lg-3 col-md-6 col-sm-12"></div>
                </div>
            </div>
        </div>

        <!-- Buttons -->
        <div class="card mb-4">
            <div class="card-body d-flex gap-2">
                <button type="button" class="btn btn-light" id="btnShipmentTypeClear">Clear</button>
                <button type="button" class="btn btn-primary" id="btnIssueMethodSave">Save</button>
            </div>
        </div>



        <!-- =========================
         BOTTOM CARD (TABLE)
    ========================== -->
        <div class="card">
            <div class="card-body">
                <h6 class="mb-3">Issue Method List</h6>

                <div class="table-responsive">
                    <table id="tblIssueMethod" class="table table-striped table-bordered" width="100%">
                        <thead>
                            <tr>
                                <th style="width:140px;">Code</th>
                                <th>Issue Type</th>
                                <th style="width:120px;">Status</th>
                                <th style="width:80px;" class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    

 
        <script src="@Url.Content("~/Content/Common/Core/TypeMaster/IssueMethod/issuemethod.js?v=1.0.0")"></script>
    

}
