@model CMMS_DAL.Modules.Core.Models.CountryOfOriginViewModel

@{
    ViewBag.Title = "Country Of Origin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/Content/css/common/page.css?v=1.0.0" rel="stylesheet" />
}

<div class="content__header content__boxed rounded-0">
   
</div>

<div class="content__boxed">
    <div class="content__wrap">

        <!-- =========================
         CARD 1: FORM
    ========================== -->
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="mb-3">Country Of Origin</h5>

                @Html.HiddenFor(m => m.Id, new { id = "CountryId" })

                <div class="row g-3">

                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Code <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Code, new { @class = "form-control", id = "CountryCode", @readonly = "readonly" })
                        <span class="text-danger" id="valCountryCode"></span>
                    </div>

                    <div class="col-lg-3 col-md-6 col-sm-12 d-flex align-items-center">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="CountryIsUserPreferred">
                            <label class="form-check-label" for="CountryIsUserPreferred">User Preferred</label>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12 col-sm-12"></div>

                    <div class="col-lg-6 col-md-12 col-sm-12">
                        <label class="form-label">Country Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.CountryName, new { @class = "form-control trim-start", id = "CountryName", placeholder = "Country Name" })
                        <span class="text-danger" id="valCountryName"></span>
                    </div>

                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Status <span class="text-danger">*</span></label>
                        <div class="position-relative">
                            @Html.DropDownListFor(m => m.Status,
                                new SelectList(new[] { new { Value = "", Text = "Select" } }, "Value", "Text"),
                                new { @class = "form-control", id = "CountryStatus" })
                            <i class="fa fa-caret-down position-absolute"
                               style="right:12px; top:50%; transform:translateY(-50%); pointer-events:none;"></i>
                        </div>
                        <span class="text-danger" id="valCountryStatus"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <button type="button" class="btn btn-light" id="btnCountryClear">Clear</button>
                <button type="button" class="btn btn-primary" id="btnCountrySave">Save</button>
            </div>
        </div>


        <!-- =========================
         CARD 2: LIST
    ========================== -->
        <div class="card">
            <div class="card-body">

                <h5 class="mb-3">Country of Origin</h5>

                <div class="table-responsive">
                    <table id="tblCountry" class="table table-striped table-bordered" width="100%">
                        <thead>
                            <tr>
                                <th style="width:140px;">Code</th>
                                <th>Country of Origin</th>
                                <th style="width:120px;">Status</th>
                                <th style="width:80px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* JS renders rows *@
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <!-- IMPORTANT: your Layout must already load jquery + datatables + sweetalert + csm-data + csm-common -->

    <script src="~/Content/Common/Core/TypeMaster/CountryOfOrigin/countryoforigin.js?v=1.0.0"></script>
}
