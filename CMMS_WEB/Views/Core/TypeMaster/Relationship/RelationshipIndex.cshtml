@model CMMS_DAL.Modules.Core.Models.RelationshipViewModel

@{
    ViewBag.Title = "Relationship";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="content__boxed">
    <div class="content__wrap">

        <!-- =========================
         PANEL 1: FORM
    ========================== -->
        <div class="card mb-3">
            <div class="card-body">

                <h5 class="mb-3">Relationship</h5>

                @Html.HiddenFor(m => m.Id, new { id = "RelationshipId" })

                <div class="row g-3">

                    <!-- Code -->
                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Code <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Code, new { @class = "form-control", id = "RelationshipCode", @readonly = "readonly" })
                        <span class="text-danger" id="valRelationshipCode"></span>
                    </div>

                    <!-- User Preferred -->
                    <div class="col-lg-3 col-md-6 col-sm-12 d-flex align-items-center">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="RelationshipIsUserPreferred" />
                            <label class="form-check-label" for="RelationshipIsUserPreferred">User Preferred</label>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12 col-sm-12"></div>

                    <!-- Relationship Name -->
                    <div class="col-lg-6 col-md-12 col-sm-12">
                        <label class="form-label">Name Of Relationship <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.RelationshipName, new { @class = "form-control trim-start", id = "RelationshipName", placeholder = "Name Of Relationship" })
                        <span class="text-danger" id="valRelationshipName"></span>
                    </div>

                    <!-- Status -->
                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Status <span class="text-danger">*</span></label>
                        <div class="position-relative">
                            @Html.DropDownListFor(m => m.Status,
                                new SelectList(new[] { new { Value = "", Text = "Select" } }, "Value", "Text"),
                                new { @class = "form-control", id = "RelationshipStatus" })
                            <i class="fa fa-caret-down position-absolute"
                               style="right:12px; top:50%; transform:translateY(-50%); pointer-events:none;"></i>
                        </div>
                        <span class="text-danger" id="valRelationshipStatus"></span>
                    </div>

                    <div class="col-lg-3 col-md-6 col-sm-12"></div>

                </div>
            </div>
        </div>

        <!-- Buttons -->
        <div class="card mb-4">
            <div class="card-body d-flex gap-2">
                <button type="button" class="btn btn-light" id="btnShipmentTypeClear">Clear</button>
                <button type="button" class="btn btn-primary" id="btnRelationshipSave">Save</button>
            </div>
        </div>



        <!-- =========================
         PANEL 2: LIST
    ========================== -->
        <div class="card">
            <div class="card-body">

                <h5 class="mb-3">Relationship List</h5>

                <div class="table-responsive">
                    <table id="tblRelationship" class="table table-striped table-bordered" width="100%">
                        <thead>
                            <tr>
                                <th style="display:none;">Id</th>   <!-- hidden -->
                                <th style="width:140px;">Code</th>
                                <th>Relationship</th>
                                <th style="width:120px;">Status</th>
                                <th style="width:80px;">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @* JS will render rows *@
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Content/Common/Core/TypeMaster/relationship.js?v=1.0.0")"></script>
}

