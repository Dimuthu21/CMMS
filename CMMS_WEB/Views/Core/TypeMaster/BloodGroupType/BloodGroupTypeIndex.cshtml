@model CMMS_DAL.Modules.Core.Models.BloodGroupTypeViewModel

@{
    ViewBag.Title = "Blood Group Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/Content/css/common/page.css?v=1.0.0" rel="stylesheet" />
}



<div class="content__boxed">
    <div class="content__wrap">

        <!-- =========================
         PANEL 1: FORM
    ========================== -->
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Blood Group Type</h5>
            </div>

            <div class="card-body">

                @Html.HiddenFor(m => m.Id, new { id = "BgId" })

                <div class="row g-3">

                    <!-- Code -->
                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Code <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Code, new { @class = "form-control", id = "BgCode", @readonly = "readonly" })
                        <span class="text-danger" id="valBgCode"></span>
                    </div>

                    <!-- User Preferred -->
                    <div class="col-lg-4 col-md-6 col-sm-12 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="BgUserPreferred">
                            <label class="form-check-label" for="BgUserPreferred">User Preferred</label>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-12 col-sm-12"></div>

                    <!-- Blood Group Type -->
                    <div class="col-lg-6 col-md-12 col-sm-12">
                        <label class="form-label">Blood Group Type <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.BloodGroupType, new { @class = "form-control trim-start", id = "BgType", placeholder = "Blood Group Type" })
                        <span class="text-danger" id="valBgType"></span>
                    </div>

                    <!-- Status -->
                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Status <span class="text-danger">*</span></label>
                        <div class="position-relative">
                            @Html.DropDownListFor(m => m.Status,
                                new SelectList(new[] { new { Value = "", Text = "Select" } }, "Value", "Text"),
                                new { @class = "form-control", id = "BgStatus" })
                            <i class="fa fa-caret-down position-absolute"
                               style="right:12px; top:50%; transform:translateY(-50%); pointer-events:none;"></i>
                        </div>
                        <span class="text-danger" id="valBgStatus"></span>
                    </div>

                    <div class="col-lg-4 col-md-12 col-sm-12"></div>
                </div>
            </div>
        </div>



        <!-- Buttons -->
        <div class="card mb-4">
            <div class="card-body d-flex gap-2">
                <button type="button" class="btn btn-light" id="btnShipmentTypeClear">Clear</button>
                <button type="button" class="btn btn-primary" id="btnBgSave">Save</button>
            </div>
        </div>


        <!-- =========================
         PANEL 2: LIST
    ========================== -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Blood Group Type List</h5>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table id="tblBloodGroupType" class="table table-striped table-bordered" width="100%">
                        <thead>
                            <tr>
                                <th style="width:140px;">Code</th>
                                <th>Blood Group Type</th>
                                <th style="width:120px;">Status</th>
                                <th style="width:80px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* JS will render rows *@
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Content/Common/Core/TypeMaster/BloodGroupType/bloodgrouptype.js?v=1.0.0")"></script>
}
