@{
    ViewBag.Title = "Business Partner List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="@Url.Content("~/Content/css/Core/core-businesspartner.css?v=1.0.0")" rel="stylesheet" />
}

<div class="content__boxed">
    <div class="content__wrap">

        <!-- ===========================
             CARD 1: FILTER PANEL
        ============================ -->
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Business Partner List</h5>

                <a href="@Url.Action("Create", "BusinessPartner", new { area = "" })"
                   class="btn btn-sm btn-primary">
                    <i class="fa fa-plus me-1"></i> New
                </a>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <!-- Type -->
                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Type</label>
                        <div class="position-relative">
                            <select id="fltBpType" class="form-control"></select>
                            <i class="fa fa-caret-down position-absolute"
                               style="right:12px; top:50%; transform:translateY(-50%); pointer-events:none;"></i>
                        </div>
                    </div>

                    <!-- Trustee -->
                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Trustee</label>
                        <div class="position-relative">
                            <select id="fltBpTrustee" class="form-control"></select>
                            <i class="fa fa-caret-down position-absolute"
                               style="right:12px; top:50%; transform:translateY(-50%); pointer-events:none;"></i>
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Status</label>
                        <div class="position-relative">
                            <select id="fltBpStatus" class="form-control"></select>
                            <i class="fa fa-caret-down position-absolute"
                               style="right:12px; top:50%; transform:translateY(-50%); pointer-events:none;"></i>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6 col-sm-12"></div>

                </div>
            </div>
        </div>

        <!-- Buttons must be separate card -->
        <div class="card mb-3">
            <div class="card-body d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary" id="btnBpClearFilter">Clear</button>
                <button type="button" class="btn btn-primary" id="btnBpFilter">Filter</button>
            </div>
        </div>

        <!-- ===========================
             CARD 2: TABLE
        ============================ -->
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="tblBpList" class="table table-striped table-bordered" width="100%">
                        <thead>
                            <tr>
                                <th style="width:140px;">Code</th>
                                <th>Name</th>
                                <th style="width:140px;">Type</th>
                                <th style="width:200px;">Trustee</th>
                                <th style="width:120px;">Status</th>
                                <th style="width:80px;">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <small class="text-body-secondary">
                    * Double-click a row to edit.
                </small>
            </div>
        </div>

    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Content/Common/Core/BusinessPartner/businesspartner-list.js?v=1.0.0")"></script>
}
