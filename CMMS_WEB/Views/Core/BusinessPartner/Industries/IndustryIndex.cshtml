@model CMMS_DAL.Modules.Core.Models.IndustryViewModel

@{
    ViewBag.Title = "Industries";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="@Url.Content("~/Content/css/Core/core-businesspartner.css?v=1.0.0")" rel="stylesheet" />
}

<div class="content__boxed">
    <div class="content__wrap">

        <!-- FORM CARD -->
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Industries</h5>
            </div>

            <div class="card-body">
                @Html.HiddenFor(m => m.Id, new { id = "IndustryId" })

                <div class="row g-3">
                    <div class="col-lg-4 col-md-6 col-sm-12">
                        <label class="form-label">
                            Code <span class="text-danger">*</span>
                        </label>

                        @Html.TextBoxFor(m => m.Code,
                            new { @class = "form-control", id = "IndustryCode", @readonly = "readonly" })

                        <span class="text-danger" id="valIndustryCode"></span>
                    </div>

                    <div class="col-lg-3 col-md-6 col-sm-12 d-flex align-items-center">
                        <div class="form-check form-switch">
                            <input class="form-check-input me-2" type="checkbox" id="IndustryUserPreferred">
                            <label class="form-check-label" for="IndustryUserPreferred">
                                User Preferred
                            </label>
                        </div>
                    </div>


                    <div class="col-lg-4 col-md-12 col-sm-12"></div>

                    <div class="col-lg-6 col-md-12 col-sm-12">
                        <label class="form-label">Industry Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.IndustryName, new { @class = "form-control trim-start", id = "IndustryName", placeholder = "Industry Name" })
                        <span class="text-danger" id="valIndustryName"></span>
                    </div>

                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Status</label>
                        <div class="position-relative">
                            @Html.DropDownListFor(m => m.Status,
                                new SelectList(new[] { new { Value = "", Text = "Select" } }, "Value", "Text"),
                                new { @class = "form-control", id = "IndustryStatus" })
                            <i class="fa fa-caret-down position-absolute" style="right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none;"></i>
                        </div>
                        <span class="text-danger" id="valIndustryStatus"></span>
                    </div>

                </div>
            </div>
        </div>

        <!-- BUTTON CARD (separate like your rule) -->
        <div class="card mb-4">
            <div class="card-body d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary" id="btnIndustryClear">Clear</button>
                <button type="button" class="btn btn-primary" id="btnIndustrySave">Save</button>
            </div>
        </div>

        <!-- LIST CARD -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Industries List</h6>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table id="tblIndustry" class="table table-striped table-bordered" width="100%">
                        <thead>
                            <tr>
                                <th style="width:140px;">Code</th>
                                <th>Industry Name</th>
                                <th style="width:120px;">Status</th>
                                <th style="width:80px;">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/Content/Common/Core/BusinessPartner/industry.js?v=1.0.0")"></script>
}
