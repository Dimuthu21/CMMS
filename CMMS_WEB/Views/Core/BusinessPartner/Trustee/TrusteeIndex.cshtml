@model CMMS_DAL.Modules.Core.Models.TrusteeViewModel

@{
    ViewBag.Title = "Trustee";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="@Url.Content("~/Content/css/Core/core-businesspartner.css?v=1.0.0")" rel="stylesheet" />
}

<div class="content__boxed">
    <div class="content__wrap">

        <!-- FORM CARD -->
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Trustee</h5>
            </div>

            <div class="card-body">
                @Html.HiddenFor(m => m.Id, new { id = "TrusteeId" })

                <div class="row g-3">

                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Code <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Code, new { @class = "form-control", id = "TrusteeCode", @readonly = "readonly" })
                        @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger", id = "valTrusteeCode" })
                    </div>

                    <div class="col-lg-3 col-md-6 col-sm-12 d-flex align-items-center">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="TrusteeUserPreferred">
                            <label class="form-check-label ms-2" for="TrusteeUserPreferred">User Preferred</label>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-12"></div>

                    <div class="col-lg-6 col-md-12 col-sm-12">
                        <label class="form-label">Trustee Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.TrusteeName, new { @class = "form-control trim-start", id = "TrusteeName", placeholder = "Trustee Name" })
                        @Html.ValidationMessageFor(m => m.TrusteeName, "", new { @class = "text-danger", id = "valTrusteeName" })
                    </div>

                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Status</label>
                        <div class="position-relative">
                            @Html.DropDownListFor(m => m.Status,
                                new SelectList(new[] { new { Value = "", Text = "Select" } }, "Value", "Text"),
                                new { @class = "form-control pe-4", id = "TrusteeStatus" })
                            <i class="fa fa-caret-down position-absolute" style="right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none;"></i>
                        </div>
                        @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger", id = "valTrusteeStatus" })
                    </div>

                </div>
            </div>
        </div>

        <!-- BUTTON CARD (SEPARATE) -->
        <div class="card mb-4">
            <div class="card-body d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary" id="btnTrusteeClear">Clear</button>
                <button type="button" class="btn btn-primary" id="btnTrusteeSave">Save</button>
            </div>
        </div>

        <!-- LIST CARD -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Trustee List</h6>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table id="tblTrustee" class="table table-striped table-bordered" width="100%">
                        <thead>
                            <tr>
                                <th style="width:140px;">Code</th>
                                <th>Trustee</th>
                                <th style="width:120px;">Status</th>
                                <th style="width:80px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* JS will render rows *@
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Content/Common/Core/BusinessPartner/trustee.js?v=1.0.0")"></script>
}

