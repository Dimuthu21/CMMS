@model CMMS_DAL.Modules.Core.Models.SectorViewModel

@{
    ViewBag.Title = "Sector";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/Content/css/Core/core-businesspartner.css?v=1.0.0" rel="stylesheet" />
}

<div class="content__boxed">
    <div class="content__wrap">

        <!-- FORM CARD -->
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Sector</h5>
            </div>

            <div class="card-body">
                @Html.HiddenFor(m => m.Id, new { id = "SectorId" })

                <div class="row g-3">

                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Code <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Code, new { @class = "form-control", id = "SectorCode", @readonly = "readonly" })
                        <span class="text-danger" id="valSectorCode"></span>
                    </div>

                    <div class="col-lg-3 col-md-6 col-sm-12 d-flex align-items-center">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="SectorUserPreferred">
                            <label class="form-check-label ms-2" for="SectorUserPreferred">
                            User Preferred</label>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12 col-sm-12"></div>

                    <div class="col-lg-6 col-md-12 col-sm-12">
                        <label class="form-label">Sector Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.SectorName, new { @class = "form-control trim-start", id = "SectorName", placeholder = "Sector Name" })
                        <span class="text-danger" id="valSectorName"></span>
                    </div>

                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label">Status</label>
                        @Html.DropDownListFor(m => m.Status,
                            new SelectList(new[] { new { Value = "", Text = "Select" } }, "Value", "Text"),
                            new { @class = "form-control", id = "SectorStatus" })
                        <span class="text-danger" id="valSectorStatus"></span>
                    </div>

                </div>
            </div>
        </div>

        <!-- BUTTON CARD -->
        <div class="card mb-4">
            <div class="card-body d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary" id="btnSectorClear">Clear</button>
                <button type="button" class="btn btn-primary" id="btnSectorSave">Save</button>
            </div>
        </div>

        <!-- LIST CARD -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Sector List</h6>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table id="tblSector" class="table table-striped table-bordered" width="100%">
                        <thead>
                            <tr>
                                <th style="width:140px;">Code</th>
                                <th>Sector</th>
                                <th style="width:160px;"></th>
                                <th style="width:120px;">Status</th>
                                <th style="width:80px;">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/Content/Common/Core/BusinessPartner/sector.js?v=1.0.0")"></script>
}
