@{
    ViewBag.Title = "Resource Error";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/css/common/status.css" rel="stylesheet" />

<div class="content__boxed">
    <div class="content__wrap">
        <div class="card">
            <div class="card-body">
                <div class="text-center">
                    <h1>Resource Error</h1>
                    <p>The requested resource does not exist, may not be available right now, or has been removed by the system.</p>
                    <p>Please contact your administrator for assistance or <a href='@Url.Action("Index", "Home")' class="link-primary">return to the homepage</a>.</p>
                    <div class="image-container">
                        <img src="@Url.Content("~/Content/images/status/resource_error.jpg")" style="width: 300px; height: 300px;" alt="Resource Error">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>